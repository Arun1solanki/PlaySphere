# Copy this file to .env and change the values.

# MySQL
DB_URL=jdbc:mysql://localhost:3306/playsphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me

# JWT: replace before any shared/staging deployment.
JWT_SECRET_BASE64=cGxheXNwaGVyZS1kZXYtc2VjcmV0LWtleS1jaGFuZ2UtbWUtMzItYnl0ZXM=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Secure browser sessions
# Keep false for local HTTP. Set true in HTTPS staging/production.
SESSION_COOKIE_NAME=playsphere_refresh
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Strict
SESSION_REGULAR_LOGIN_HOURS=12
SESSION_PLAYER_IDLE_MINUTES=60
SESSION_ORGANIZER_IDLE_MINUTES=45
SESSION_TURF_OWNER_IDLE_MINUTES=45
SESSION_ADMIN_IDLE_MINUTES=20
SESSION_SUPER_ADMIN_IDLE_MINUTES=15

# Frontend
APP_FRONTEND_URL=http://localhost:5173

# Email provider: log | brevo
APP_EMAIL_PROVIDER=log
EMAIL_VERIFICATION_MINUTES=30
PASSWORD_RESET_MINUTES=30
EMAIL_RESEND_COOLDOWN_SECONDS=60
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PlaySphere

# Optional preset local demo accounts for every role
# Never enable these in staging or production.
APP_SEED_DEMO_ACCOUNTS=false
APP_DEMO_PASSWORD=Demo@12345

# Optional standalone development admin seed
APP_SEED_ADMIN=false
APP_ADMIN_EMAIL=admin@playsphere.local
APP_ADMIN_PASSWORD=ChangeMe@12345

# Media storage: local or cloudinary
APP_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Map/geocoding provider. The Nominatim option is intended for light local-development use.
APP_MAPS_PROVIDER=nominatim
NOMINATIM_USER_AGENT=PlaySphere-Local-Development-0.1-your-email@example.com

# Payments: development or razorpay
APP_PAYMENT_PROVIDER=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
